{
  "name": "@job-autoapply/host",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "job-autoapply-host": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup && cp src/db/schema.sql dist/schema.sql && cp src/automation/linkedin/selectors.linkedin.json dist/selectors.linkedin.json && cp src/automation/naukri/selectors.naukri.json dist/selectors.naukri.json",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@job-autoapply/shared": "*",
    "better-sqlite3": "^11.3.0",
    "pino": "^9.3.2",
    "playwright-core": "^1.46.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
