{
  "manifest_version": 3,
  "name": "Auto-Apply Jobs",
  "version": "1.1.0",
  "description": "Automate LinkedIn Easy Apply and Naukri job applications — load and go, no install needed",
  "permissions": ["storage", "tabs", "activeTab", "sidePanel", "downloads", "webNavigation", "webRequest", "scripting", "debugger", "notifications"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://api.emailjs.com/*",
    "https://api.brevo.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Auto-Apply Jobs",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "src/popup/index.html"
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://www.naukri.com/*"],
      "js": ["src/content-scripts/automation.ts"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["public/icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
