{
  "name": "job-autoapply",
  "private": true,
  "version": "1.0.0",
  "description": "AI Job Auto-Applier — Chrome Extension + Playwright Automation Engine",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @job-autoapply/shared && npm run build --workspaces --if-present",
    "dev:extension": "npm run dev -w @job-autoapply/extension",
    "dev:host": "npm run dev -w @job-autoapply/host",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint packages --ext .ts,.tsx"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
